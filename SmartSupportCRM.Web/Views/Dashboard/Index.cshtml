@{ ViewData["Title"] = "Dashboard"; }

<h1>AI Dashboard</h1>
<canvas id="sentimentChart" width="400" height="200"></canvas>
<p id="chartError" class="text-danger" role="alert"></p>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    fetch('@Url.Action("GetSentimentStats", "Dashboard")')
        .then(response => {
            if (!response.ok) throw new Error('Could not load statistics.');
            return response.json();
        })
        .then(data => {
            const ctx = document.getElementById('sentimentChart').getContext('2d');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Positive', 'Neutral', 'Negative'],
                    datasets: [{
                        data: [data.positive, data.neutral, data.negative],
                        backgroundColor: ['#28a745', '#ffc107', '#dc3545']
                    }]
                }
            });
        })
        .catch(() => {
            document.getElementById('chartError').textContent = 'Statistics are unavailable. Please try again later.';
        });
</script>
